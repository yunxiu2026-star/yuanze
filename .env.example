# No live secrets. Copy to .env.production and generate independent random values.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
# Optional GEO notifications. Empty values send nothing.
WEBSITE_NOTIFY_WEBHOOK_URL=
WEBSITE_NOTIFY_WEBHOOK_KIND=auto
WEBSITE_NOTIFY_WEBHOOK_SECRET=
WEBSITE_NOTIFY_SMTP_HOST=
WEBSITE_NOTIFY_SMTP_PORT=587
WEBSITE_NOTIFY_SMTP_USER=
WEBSITE_NOTIFY_SMTP_PASSWORD=
WEBSITE_NOTIFY_SMTP_FROM=
WEBSITE_NOTIFY_SMTP_TO=
WEBSITE_NOTIFY_SMTP_MODE=starttls
# Native launcher reads environment variables, not .env automatically.
